# Runtime state written by the application; never part of the package.
data/
installed.flag

# Python and tooling caches.
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.venv/

# Editor and OS droppings.
.DS_Store
Thumbs.db
desktop.ini

# Third-party binaries (about 320 MB). Restore them with
#   python3 developer/fetch_binaries.py
# Sources and SHA-256 values are in THIRD_PARTY.md; the expected hash of every
# placed file is in bundle.json. Only the two small config/notice files of the
# embedded Windows Python are tracked.
runtime/*
!runtime/LICENSE.txt
!runtime/python313._pth
app/bin/ffmpeg
app/bin/ffprobe
app/bin/ffmpeg.exe
app/bin/ffprobe.exe
developer/.cache/

# Generated by developer/build_release.py.
developer/install_files.nsh
developer/uninstall_files.nsh
developer/launcher.res
dist/
